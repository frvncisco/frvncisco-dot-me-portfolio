# Feature flags — hide a page by leaving its var unset or anything other
# than "true". See src/lib/flags.ts. Routes prerender at build time, so
# changing these on a host like Vercel requires a redeploy to take effect.
FEATURE_BLOG=true
FEATURE_WORK=true
FEATURE_CONTACT=true

# Base URL for absolute links (metadataBase, og:url, sitemap, robots, JSON-LD).
# Optional. Unset: Vercel previews use their own URL, `next dev` uses
# localhost, and production falls back to DATA.url in src/data/resume.tsx.
# Set it on Vercel Production while DATA.url's domain isn't connected yet.
# SITE_URL=https://frvncisco-dot-me-portfolio.vercel.app
